# ── AI Provider — AWS Bedrock (primary) ───────────────────────────────────────
# AWS credentials — used for Bedrock (AI), Amplify (deploy), S3 (media uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Bedrock model — Claude Sonnet 4 (cross-region inference)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Fallback: Anthropic direct (used when AWS creds not set)
ANTHROPIC_API_KEY=

# ── Auth — AWS Cognito (artispreneur-agent pool) ───────────────────────────────
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_POOL_ID=us-east-1_VyKGNlV9r
NEXT_PUBLIC_COGNITO_CLIENT_ID=6dfqmemi0kvha7u3vbu2rq8n4h

# ── Storage — S3 (EPK media uploads) ──────────────────────────────────────────
EPK_MEDIA_BUCKET=artispreneur-epk-media

# ── Database — Supabase (optional — leave blank to use Cognito-only auth) ─────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Payments — Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_EPK_EDIT=price_xxx       # $9.99 — Edit Access
STRIPE_PRICE_EPK_STYLE_PRO=price_xxx  # $20   — Style Pro
STRIPE_PRICE_EPK_PREMIUM=price_xxx    # $49   — Premium

# ── Music integrations ────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Media ─────────────────────────────────────────────────────────────────────
PEXELS_API_KEY=

# ── DeepSeek (legacy fallback — no longer primary) ────────────────────────────
