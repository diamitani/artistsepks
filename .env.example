# ── Required: AI (Vercel AI Gateway) ────────────────────────────────────────────
# Powers the EPK interview agent, bio generation, and every other LLM call in
# this app — all requests go through the Vercel AI Gateway, which can route to
# Anthropic, OpenAI, Google, DeepSeek, and more with one key.
# Get a key: https://vercel.com/dashboard -> your team -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=

# Optional: override the primary model. Must be a Gateway-namespaced model id,
# e.g. moonshotai/kimi-k3, anthropic/claude-sonnet-5, openai/gpt-5.5, or
# deepseek/deepseek-v4-pro. Defaults to moonshotai/kimi-k3 (Kimi) if unset.
GATEWAY_MODEL=
# Optional: comma-separated models the Gateway fails over to if the primary
# errors. Defaults to Kimi + Claude Sonnet (minus whichever is primary).
GATEWAY_FALLBACK_MODELS=

# ── Required: Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Required: Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Per-EPK pricing (one-time payment products in Stripe)
STRIPE_PRICE_EPK_EDIT=price_xxx          # $9.99 — Edit Access
STRIPE_PRICE_EPK_STYLE_PRO=price_xxx     # $20   — Style Pro
STRIPE_PRICE_EPK_PREMIUM=price_xxx       # $49   — Premium

# ── Optional: Spotify ──────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── Optional: Pexels ───────────────────────────────────────────────────────────
PEXELS_API_KEY=

# ── Optional: Composio ─────────────────────────────────────────────────────────
# Google Drive save/import, plus read-only Spotify/Instagram/TikTok/YouTube
# profile connections. Does NOT enable posting/publishing on an artist's
# behalf — that's intentionally out of scope. Get a key at
# https://app.composio.dev (Settings -> API Keys). Without it, /api/composio/*
# routes respond 503 and connection UI should show "not connected".
COMPOSIO_API_KEY=
